# AGRI TECH - Environment Variables Configuration
# Copy this file to .env for local overrides if connecting external production APIs.
# By default, AGRI TECH runs offline out-of-the-box with complete simulated datasets!

# 1. Port and Host configuration
VITE_PORT=5173
VITE_HOST=localhost

# 2. Agricultural Market API (Optional - Default uses built-in APMC Benchmark Model)
# e-NAM / Agmarknet API endpoint
VITE_MANDI_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a7b0070c
VITE_MANDI_API_KEY=your_data_gov_in_api_key_here

# 3. Weather Service (Optional - Default uses Open-Meteo & simulated agro-meteorology)
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# 4. LLM Assistant (Optional - Default uses Mitra AI Multilingual Deterministic Engine)
# Gemini API Key (keep private, never commit real keys)
VITE_GEMINI_API_KEY=your_gemini_api_key_if_connecting_live_llm
